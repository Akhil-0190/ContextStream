# Gemini key for user-triggered video-frame analysis.
GEMINI_API_KEY=

# Active Gemini fallback ordering. "compromise" starts with Gemini 3.5 Flash-Lite,
# proven to respond quickly in the latest run; "recommended" prioritizes
# quality/speed and is kept available for later selection.
GEMINI_MODEL_PROFILE=compromise

# Optional override: set false to disable grounded Google web search.
# Enabled by default when GEMINI_API_KEY is configured; the app allows 100
# grounded-search API calls per UTC month on this local installation.
GEMINI_GROUNDED_SEARCH=true

# Brave Search key for live product web results. Keep server-side only.
BRAVE_SEARCH_API_KEY=

# Optional maximum wait for SearchApi.io Shopping responses (milliseconds).
# Defaults to 120000; valid values are clamped between 60000 and 600000.
SEARCHAPI_PRODUCT_TIMEOUT_MS=120000

# Optional Google Lens visual search + structured Google Shopping offers via SerpApi.
# Free plan currently lists 250 searches/month; one selected object uses roughly
# one Lens search and one Shopping search, plus the existing Brave/Gemini routes.
SERPAPI_API_KEY=
